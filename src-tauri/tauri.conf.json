{
  "productName": "JIRA Logwork",
  "version": "../package.json",
  "identifier": "com.jira-logwork.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "JIRA Logwork",
      "width": 1200,
      "height": 800,
      "resizable": true,
      "maximized": true,
      "dragDropEnabled": false
    }],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "wembyjuniarrochman",
    "copyright": "© 2026 wembyjuniarrochman",
    "shortDescription": "Pencatat worklog Jira",
    "longDescription": "Aplikasi desktop untuk mencatat worklog Jira lewat kalender, dengan penjadwalan draf dan auto-update.",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBRTdENjFBMDE2MURGQ0QKUldUTjMyRUJHdGJuYXN2a0JRc2s2OXVXSWRkTlJodGRmdGVnM1hmaE9ZL08zNnJNZ01pSStZT2cK",
      "endpoints": [
        "https://github.com/wembyjuniarrochman/jira-logwork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
