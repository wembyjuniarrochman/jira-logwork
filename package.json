{
  "name": "jira-logwork",
  "version": "1.0.3",
  "description": "Aplikasi desktop untuk mencatat worklog Jira lewat kalender, dengan penjadwalan draf dan auto-update.",
  "author": "wembyjuniarrochman",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/wembyjuniarrochman/jira-logwork.git"
  },
  "homepage": "https://github.com/wembyjuniarrochman/jira-logwork",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest --run",
    "test:watch": "vitest",
    "release:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "release:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "release:feed": "node scripts/make-latest-json.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "bits-ui": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "shadcn": "^4.8.0",
    "svelte": "^5.55.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/ui": "^4.1.7",
    "esbuild": "^0.28.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
